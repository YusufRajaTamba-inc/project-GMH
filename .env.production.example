# Salin ke .env di server VPS lalu isi nilainya. Jangan pernah commit file ini.

POSTGRES_DB=foundationos
POSTGRES_USER=gmh
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK_PANJANG

# Minimal 32 karakter, hasil acak: openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_HASIL_RANDOM

JWT_EXPIRES_IN=7d

# Origin web yang diizinkan (pisah koma bila lebih dari satu)
ALLOWED_ORIGIN=http://139.190.105.192

# Cookie JWT memakai flag Secure (HTTPS). Set false hanya untuk staging via IP
# tanpa TLS. Jangan set false di produksi dengan domain HTTPS.
COOKIE_SECURE=false

# Base URL API yang di-bundle ke frontend (proxy Nginx ke /api/v1)
VITE_API_BASE_URL=/api/v1
